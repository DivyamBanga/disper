<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Near-black with a faint warm tint; surfaces separate by lightness, not by heavy borders. -->
    <Color x:Key="C.Bg">#141416</Color>
    <Color x:Key="C.BgSidebar">#161618</Color>
    <Color x:Key="C.BgElevated">#1E1E21</Color>
    <Color x:Key="C.BgInput">#232327</Color>
    <Color x:Key="C.BgHover">#26262A</Color>
    <Color x:Key="C.BgActive">#2E2E33</Color>
    <Color x:Key="C.Border">#2A2A2E</Color>
    <Color x:Key="C.BorderStrong">#3A3A40</Color>
    <Color x:Key="C.Text">#F2F1EF</Color>
    <Color x:Key="C.TextSecondary">#9D9CA1</Color>
    <Color x:Key="C.TextTertiary">#6C6B71</Color>
    <Color x:Key="C.Danger">#E5695B</Color>
    <Color x:Key="C.DangerSoft">#2E1B19</Color>
    <Color x:Key="C.Shadow">#50000000</Color>
</ResourceDictionary>
