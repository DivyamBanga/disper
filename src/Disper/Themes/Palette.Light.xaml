<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Warm, low-contrast neutrals so the app feels calm rather than clinical. -->
    <Color x:Key="C.Bg">#FBFBFA</Color>
    <Color x:Key="C.BgSidebar">#F4F4F2</Color>
    <Color x:Key="C.BgElevated">#FFFFFF</Color>
    <Color x:Key="C.BgInput">#FFFFFF</Color>
    <Color x:Key="C.BgHover">#F0EFEC</Color>
    <Color x:Key="C.BgActive">#E9E8E4</Color>
    <Color x:Key="C.Border">#E7E6E2</Color>
    <Color x:Key="C.BorderStrong">#D8D7D2</Color>
    <Color x:Key="C.Text">#1B1B18</Color>
    <Color x:Key="C.TextSecondary">#6C6B65</Color>
    <Color x:Key="C.TextTertiary">#9B9A93</Color>
    <Color x:Key="C.Danger">#D5493B</Color>
    <Color x:Key="C.DangerSoft">#FBECEA</Color>
    <Color x:Key="C.Shadow">#26000000</Color>
</ResourceDictionary>
