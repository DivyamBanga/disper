<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:dash="clr-namespace:Disper.Dashboard">

    <!-- ================= Brushes (colors come from the swappable palette) ================= -->
    <SolidColorBrush x:Key="B.Bg" Color="{DynamicResource C.Bg}" />
    <SolidColorBrush x:Key="B.BgSidebar" Color="{DynamicResource C.BgSidebar}" />
    <SolidColorBrush x:Key="B.BgElevated" Color="{DynamicResource C.BgElevated}" />
    <SolidColorBrush x:Key="B.BgInput" Color="{DynamicResource C.BgInput}" />
    <SolidColorBrush x:Key="B.BgHover" Color="{DynamicResource C.BgHover}" />
    <SolidColorBrush x:Key="B.BgActive" Color="{DynamicResource C.BgActive}" />
    <SolidColorBrush x:Key="B.Border" Color="{DynamicResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{DynamicResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{DynamicResource C.Text}" />
    <SolidColorBrush x:Key="B.TextSecondary" Color="{DynamicResource C.TextSecondary}" />
    <SolidColorBrush x:Key="B.TextTertiary" Color="{DynamicResource C.TextTertiary}" />
    <SolidColorBrush x:Key="B.Danger" Color="{DynamicResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="{DynamicResource C.DangerSoft}" />
    <SolidColorBrush x:Key="B.Accent" Color="{DynamicResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentText" Color="{DynamicResource C.AccentText}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="{DynamicResource C.AccentSoft}" />

    <FontFamily x:Key="F.Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Radius">10</sys:Double>

    <!-- ================= Typography ================= -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style x:Key="T.Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource B.TextTertiary}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================= Buttons ================= -->
    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.BgElevated}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                            BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgActive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small icon button (Segoe Fluent Icons glyph as Content) -->
    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                        <!-- Explicit TextBlock so the icon font wins over the app's default TextBlock style. -->
                        <TextBlock x:Name="g" Text="{TemplateBinding Content}" FontFamily="{StaticResource F.Icons}"
                                   FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                            <Setter TargetName="g" Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Card ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.BgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- ================= TextBox ================= -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.BgInput}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{Binding (dash:Hint.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource B.TextTertiary}" FontFamily="{StaticResource F.Sans}" FontSize="13.5"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Toggle switch (styled ToggleButton) =================
         The on-state is declared with Setters so the initial state always renders correctly; the smooth
         thumb slide comes from Checked/Unchecked event animations that fire on user interaction. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="23">
                        <Border CornerRadius="12" Background="{DynamicResource B.BgActive}" />
                        <!-- No local Opacity: a local value would outrank the trigger Setters below. -->
                        <Border x:Name="trackOn" CornerRadius="12" Background="{DynamicResource B.Accent}" />
                        <Border x:Name="thumb" Width="17" Height="17" CornerRadius="9"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" Background="White">
                            <Border.Effect>
                                <!-- A faint shadow keeps the thumb legible on any accent, light ones included. -->
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Direction="270" Opacity="0.35" Color="Black" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="tx" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Track color is set declaratively for both states (no local value to override it);
                             the thumb slides via the Checked/Unchecked events, which fire when IsChecked is
                             set after the page is in the tree (see DashboardWindow.Navigate). -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="trackOn" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="trackOn" Property="Opacity" Value="1" />
                        </Trigger>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="17" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Page scaffold ================= -->
    <Style TargetType="dash:PageScaffold">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dash:PageScaffold">
                    <Grid Margin="34,10,34,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,22">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource T.Display}" />
                                <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource T.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ContentPresenter Content="{TemplateBinding Actions}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <ContentPresenter Content="{TemplateBinding Body}" Margin="0,0,0,28" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Setting row ================= -->
    <Style TargetType="dash:SettingRow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="dash:SettingRow">
                    <Grid MinHeight="52" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource T.Body}" FontWeight="Medium" />
                            <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource T.Secondary}" FontSize="12.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Control}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ComboBox ================= -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="b" Background="{DynamicResource B.BgInput}" CornerRadius="9"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="11,0">
            <Grid>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,22,0" />
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="9"
                           Foreground="{DynamicResource B.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.BorderStrong}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Combo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press" Cursor="Hand" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Border}"
                                    BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tray context menu ================= -->
    <Style x:Key="TrayMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Border}"
                            BorderThickness="1" CornerRadius="11" Padding="5" MinWidth="196">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.32" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}" FontFamily="{StaticResource F.Icons}"
                                       FontSize="15" Foreground="{DynamicResource B.TextSecondary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource B.Text}" />
                            <TextBlock x:Name="check" Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource F.Icons}"
                                       FontSize="13" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TraySep" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource B.Border}" Margin="8,5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slim scrollbar ================= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource B.BorderStrong}" CornerRadius="5"
                                                    Margin="2,0" Width="6" HorizontalAlignment="Right" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
