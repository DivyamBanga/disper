<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Disper</AssemblyName>
    <RootNamespace>Disper</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/disper.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WindowsDesktop SDK drops these from the implicit set to avoid the System.Windows.Shapes.Path clash. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons are loaded from disk with LoadImage, so they ship next to the exe. -->
    <Content Include="Assets/*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
