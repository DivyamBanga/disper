<UserControl x:Class="Disper.Dashboard.SnippetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:Disper.Dashboard">
    <dash:PageScaffold Title="Snippets" Subtitle="Say a trigger phrase to drop in a saved block of text.">
        <dash:PageScaffold.Body>
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <!-- Add row -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBox x:Name="TriggerBox" Style="{StaticResource Input}" Margin="0,0,0,8"
                                 dash:Hint.Placeholder="When I say… (e.g. my email)" KeyDown="OnTriggerKey" />
                        <TextBox x:Name="TextBoxContent" Style="{StaticResource Input}" Height="80" Margin="0,0,0,12"
                                 dash:Hint.Placeholder="Insert this text…" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="11,8" />
                        <Button x:Name="AddBtn" Style="{StaticResource Btn.Primary}" Content="Add snippet" HorizontalAlignment="Right" Width="130" Click="OnAdd" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="EmptyState" Margin="0,50,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource F.Icons}" FontSize="34" Foreground="{DynamicResource B.TextTertiary}" HorizontalAlignment="Center" />
                    <TextBlock Text="No snippets yet." Style="{StaticResource T.Secondary}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                    CornerRadius="11" Padding="16,12" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource B.AccentSoft}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding Trigger}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource T.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Content="&#xE74D;" ToolTip="Delete" Tag="{Binding Index}" Click="OnDelete" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </dash:PageScaffold.Body>
    </dash:PageScaffold>
</UserControl>
