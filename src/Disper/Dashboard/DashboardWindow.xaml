<Window x:Class="Disper.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Disper.Dashboard"
        Title="Disper" Width="940" Height="640" MinWidth="820" MinHeight="540"
        Background="{DynamicResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0,0,0,1" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Sidebar navigation item -->
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="11,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource F.Icons}"
                                           FontSize="16" Width="24" Foreground="{DynamicResource B.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource F.Sans}"
                                           FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgActive}" />
                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource B.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption min/close buttons -->
        <Style x:Key="Caption" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource B.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource B.BgHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource B.BgSidebar}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
            <Grid Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,0,20" VerticalAlignment="Center">
                    <local:Wordmark Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="Disper" FontFamily="{StaticResource F.Display}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavHome" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Home" IsChecked="True" Checked="OnNav" />
                    <RadioButton x:Name="NavHistory" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE81C;" Content="History" Checked="OnNav" />
                    <RadioButton x:Name="NavDictionary" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE82D;" Content="Dictionary" Checked="OnNav" />
                    <RadioButton x:Name="NavSnippets" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE8C8;" Content="Snippets" Checked="OnNav" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="{DynamicResource B.Border}" Margin="6,4,6,10" />
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings" Checked="OnNav" />
                    <Border Margin="8,12,8,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource B.TextTertiary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Starting…" Style="{StaticResource T.Secondary}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: drag region + window buttons -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0">
                    <Button x:Name="MinBtn" Style="{StaticResource Caption}" Click="OnMinimize" ToolTip="Minimize">
                        <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CloseBtn" Style="{StaticResource Caption}" Click="OnClose" ToolTip="Close to tray">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0" />
        </Grid>
    </Grid>
</Window>
