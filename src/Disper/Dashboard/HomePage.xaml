<UserControl x:Class="Disper.Dashboard.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:Disper.Dashboard">
    <dash:PageScaffold x:Name="Scaffold" Title="Home">
        <dash:PageScaffold.Body>
            <StackPanel>
                <!-- Stat cards -->
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="WORDS TODAY" Style="{StaticResource T.Caption}" />
                            <TextBlock x:Name="WordsToday" Text="0" Style="{StaticResource T.Display}" FontSize="30" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="WORDS ALL-TIME" Style="{StaticResource T.Caption}" />
                            <TextBlock x:Name="WordsTotal" Text="0" Style="{StaticResource T.Display}" FontSize="30" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="TIME SAVED" Style="{StaticResource T.Caption}" />
                            <TextBlock x:Name="TimeSaved" Text="0m" Style="{StaticResource T.Display}" FontSize="30" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="DAY STREAK" Style="{StaticResource T.Caption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="Streak" Text="0" Style="{StaticResource T.Display}" FontSize="30" />
                                <TextBlock x:Name="StreakFlame" Text="&#xE7A6;" FontFamily="{StaticResource F.Icons}" FontSize="15"
                                           Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center" Margin="8,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- How to dictate -->
                <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hold to talk" Style="{StaticResource T.H2}" />
                            <TextBlock x:Name="HotkeyHint" Style="{StaticResource T.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"
                                       Text="Hold your key anywhere, speak, and let go. Your words drop into whatever you're typing in." />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border Background="{DynamicResource B.BgInput}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="7" Padding="12,7">
                                    <TextBlock x:Name="KeyCap" Text="Right Alt" FontWeight="SemiBold" FontSize="13" />
                                </Border>
                                <TextBlock Text="hold &#183; tap to lock hands-free &#183; Esc to cancel" Style="{StaticResource T.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="TestBtn" Style="{StaticResource Btn.Secondary}" Content="Test microphone" Click="OnTestMic"
                                HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <!-- Mic meter (shown during test) -->
                <Border x:Name="MeterCard" Style="{StaticResource Card}" Padding="24,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="MeterLabel" Text="Say something…" Style="{StaticResource T.Secondary}" Margin="0,0,0,12" />
                        <Border Height="8" CornerRadius="4" Background="{DynamicResource B.BgActive}">
                            <Border x:Name="MeterFill" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource B.Accent}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </dash:PageScaffold.Body>
    </dash:PageScaffold>
</UserControl>
