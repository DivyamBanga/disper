<UserControl x:Class="Disper.Dashboard.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:Disper.Dashboard">
    <dash:PageScaffold Title="Dictionary" Subtitle="Teach Disper the exact spelling of names and terms.">
        <dash:PageScaffold.Body>
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <!-- Add row -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WordBox" Grid.Column="0" Style="{StaticResource Input}" Margin="0,0,8,0"
                                 dash:Hint.Placeholder="Word (e.g. Divyam)" KeyDown="OnKeyDown" />
                        <TextBox x:Name="SoundsBox" Grid.Column="1" Style="{StaticResource Input}" Margin="0,0,8,0"
                                 dash:Hint.Placeholder="Sounds like (optional)" KeyDown="OnKeyDown" />
                        <Button x:Name="AddBtn" Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="Add" Width="72" Click="OnAdd" />
                    </Grid>
                </Border>

                <StackPanel x:Name="EmptyState" Margin="0,50,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE82D;" FontFamily="{StaticResource F.Icons}" FontSize="34" Foreground="{DynamicResource B.TextTertiary}" HorizontalAlignment="Center" />
                    <TextBlock Text="No words yet. Add one above." Style="{StaticResource T.Secondary}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource B.BgElevated}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                    CornerRadius="11" Padding="16,11" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Word}" Style="{StaticResource T.Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sounds}" Style="{StaticResource T.Secondary}" FontSize="12.5" Margin="0,2,0,0"
                                                   Visibility="{Binding SoundsVisible}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Content="&#xE74D;" ToolTip="Delete" Tag="{Binding Index}" Click="OnDelete" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </dash:PageScaffold.Body>
    </dash:PageScaffold>
</UserControl>
